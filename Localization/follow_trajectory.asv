function followOdeTrajectory()
% followOdeTrajectory computes an ODE-based reference trajectory and then
% sequentially commands the TurtleBot to follow the trajectory by moving
% from one waypoint to the next using the go_to_point function.
%
% It also logs the actual final pose after reaching each waypoint and
% plots the complete reference trajectory vs. the actual path.
%
% Assumptions:
%   - ROS is running.
%   - The helper functions get_current_pose(sub) and go_to_point(x, y, theta)
%     are implemented and accessible.
%
% Author: Your Name
% Date: Today's Date

    %% 1. Compute the Reference Trajectory from an ODE Model
    % Define time parameters
    T = 20;          % Total duration (seconds)
    dt = 0.2;        % Time step for ODE solution (seconds)
    t_span = 0:dt:T;
    
    % Set constant control inputs (example: for a circular trajectory)
    v = 0.1;         % Constant linear speed (m/s)
    omega = 0.1;     % Constant angular speed (rad/s)
    
    % Define the unicycle model ODE:
    %   dx/dt = v*cos(theta)
    %   dy/dt = v*sin(theta)
    %   dtheta/dt = omega
    ode_sys = @(t, state) [v * cos(state(3));
                           v * sin(state(3));
                           omega];
                       
    % Obtain the initial state from odometry
    sub = rossubscriber(/odom', 'nav_msgs/Odometry');
    [x0, y0, theta0] = get_current_pose(sub);
    initial_state = [x0; y0; theta0];
    
    % Solve the ODE to generate the continuous reference trajectory
    [t_sol, sol] = ode45(ode_sys, t_span, initial_state);
    x_traj = sol(:,1);
    y_traj = sol(:,2);
    theta_traj = sol(:,3);
    
    %% 2. Sample the Trajectory into Discrete Waypoints
    % To avoid too many waypoints, sample every N-th point.
    N = 5;  % Adjust this value as needed.
    indices = 1:N:length(t_sol);
    waypoints = [x_traj(indices), y_traj(indices), theta_traj(indices)];
    numWaypoints = size(waypoints, 1);
    
    fprintf('Total waypoints to follow: %d\n', numWaypoints);
    
    % Initialize a matrix to log the actual poses (final pose at each waypoint)
    actualPath = [];
    
    %% 3. Command the Robot to Follow the Trajectory
    for i = 1:numWaypoints
        % Extract the target waypoint.
        x_target = waypoints(i, 1);
        y_target = waypoints(i, 2);
        theta_target = waypoints(i, 3);
        
        fprintf('Moving to waypoint %d: (x = %.2f, y = %.2f, theta = %.2f rad)\n', ...
                i, x_target, y_target, theta_target);
        
        % Call the go_to_point function to move the robot to this waypoint.
        % It is assumed that this function blocks until the robot reaches the target pose.
        go_to_point(x_target, y_target, theta_target);
        
        % After reaching the waypoint, get the current pose and log it.
        pause(0.5); % Optional pause to let the robot settle
        [x_act, y_act, theta_act] = get_current_pose(sub);
        actualPath = [actualPath; x_act, y_act, theta_act];
    end
    
    fprintf('Completed following the ODE trajectory.\n');
    
    %% 4. Plot the Reference Trajectory vs. Actual Path
    figure;
    % Plot the continuous reference trajectory
    plot(x_traj, y_traj, 'b--', 'LineWidth', 2);
    hold on;
    % Plot the discrete actual poses recorded at each waypoint
    plot(actualPath(:,1), actualPath(:,2), 'ro-', 'LineWidth', 2, 'MarkerSize', 8);
    xlabel('X (m)');
    ylabel('Y (m)');
    title('Reference Trajectory vs. Actual Path');
    legend('Reference Trajectory', 'Actual Path');
    grid on;
end
