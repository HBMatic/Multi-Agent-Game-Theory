function par = problemData_MD_rescue(destroyed_defenders)
    par.defender = length(find(~destroyed_defenders));
    defender = par.defender;
    % Parameters
    par.meu = 1;
    par.sigma(1) = 0.2; % Attacker's capture radius
    par.sigma(2) = 0.1; % For all small_defender radius
    par.sigma(3) = 0.3; % One big defender capture radius
    agents = defender + 2;  % Total number of agents (1 attacker + n defenders + 1 target)
    
    % Symbolic variables
    syms Xa1 Xa2 Xt1 Xt2 real;
    Xa = [Xa1; Xa2];
    Xt = [Xt1; Xt2];
    
    % Initialize state variables for defenders
    par.n = 2 * agents;
    X =[Xa; sym(zeros(2*defender,1)); Xt];

    I = eye(agents);
    par.A = zeros(par.n, par.n);
    par.Ba = kron(I(:, 1), eye(2, 2));
    par.Bt = kron(I(:, defender + 2), eye(2, 2));
    par.Ra = 5 * eye(2, 2);
    par.Rt = 10 * eye(2, 2);
    par.Sa = par.Ba * (par.Ra \ par.Ba');
    par.St = par.Bt * (par.Rt \ par.Bt');
    par.Qa = eye(2, 2);
    par.Qt = eye(2, 2);

    for i = 1:defender
        par.Bd{i} = kron(I(:, i+1), eye(2, 2));
        par.Rd{i} =  * eye(2, 2);
        par.Sd{i} = par.Bd{i} / par.Rd{i} * par.Bd{i}';
        X(2*i+1:2*(i+1)) = sym(['Xd' num2str(i) '_1'; 'Xd' num2str(i) '_2']);
    end
    
    % Objective functions
    
    obj{1} = (Xa - Xt)' * par.Qa * (Xa - Xt);  % Attacker
    obj{defender + 2} = -(Xt - Xa)' * par.Qt * (Xt - Xa);  % Target vs attacker
    
    for i = 1:defender
        Xd_i = X(2*i+1:2*(i+1));
        obj{i + 1} = (Xd_i - Xt)' * eye(2,2) * (Xd_i - Xt);  % Each defender vs target
        obj{defender + 2} = obj{defender + 2} + par.meu * ((Xt - Xd_i)' * par.Qt * (Xt - Xd_i));  % Target vs each defender
    end
    
    % Hessians
    par.Qa1 = 0.5 * double(hessian(obj{1}, X));
    for i = 1:defender
        par.(['Qd', num2str(i)]) = 0.5 * double(hessian(obj{i + 1}, X));
    end
    par.Qt1 = 0.5 * double(hessian(obj{defender + 2}, X));
end
