function par = problemData_MD_intercept(destroyed_defenders)
    par.defender = length(find(~destroyed_defenders));
    defender = par.defender;
    % Parametere
    par.lamda = 1;
    par.sigma(1) = 0.09; % Attacker's capture radius
    par.sigma(2) = 0.1; % For all small_defender radius
    par.sigma(3) = 0.2; % One big defender capture radius
    agents = par.defender + 2;  % Total number of agents (1 attacker + n defenders + 1 target)
    
    % Symbolic variables
    syms Xa1 Xa2 Xt1 Xt2 real;

    Xa = [Xa1; Xa2];
    Xt = [Xt1; Xt2];
    
    % Initialize state variables for defenders
    par.n = 2 * agents;
    X =[Xa; sym(zeros(2*defender,1));Xt];
 
   
    I = eye(agents);
    par.A = zeros(par.n, par.n);
    par.Ba = kron(I(:, 1), eye(2, 2));
    par.Bt = kron(I(:, defender + 2), eye(2, 2));
    par.Ra = 3 * eye(2, 2); %0.75 * eye(2, 2)
    par.Rt = 15 * eye(2, 2); %1.25 * eye(2, 2)
    par.Sa = par.Ba * (par.Ra \ par.Ba');
    par.St = par.Bt * (par.Rt \ par.Bt');
    par.Qa = eye(2, 2);
    par.Qt = eye(2, 2);

    
    for i = 1:par.defender
        par.Bd{i} = kron(I(:, i+1), eye(2,2));
        par.Rd{i} = 6 * eye(2, 2); %1*eye(2, 2)
        par.Sd{i} = par.Bd{i} / par.Rd{i} * par.Bd{i}';
        X(2*i+1:2*(i+1)) = sym(['Xd' num2str(i) '_1'; 'Xd' num2str(i) '_2']);
    end
    
    % Objective function
    obj{1} = (Xa - Xt)' * par.Qa * (Xa - Xt);  % Attacker
    obj{defender+2} = -(Xt - Xa)' * par.Qt * (Xt - Xa);
    for i = 1:par.defender
        Xd_i = X(2*i+1:2*(i+1));
        obj{1} = obj{1} - par.lamda*(Xa - Xd_i)' * par.Qa * (Xa - Xd_i);  % Attacker vs each defender
        obj{i+1} = (Xd_i - Xa)' * eye(2,2) * (Xd_i - Xa);  % Each defender vs attacker
    end
    
    
    % Hessians
    par.Qa1 = 0.5 * double(hessian(obj{1}, X));
    par.Qt1 = 0.5 * double(hessian(obj{defender+2}, X));
    for i = 1:par.defender
        par.(['Qd', num2str(i)]) = 0.5 * double(hessian(obj{i+1}, X));
    end
end
