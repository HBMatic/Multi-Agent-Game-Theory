function [attackerTraj, targetTraj, defenderTraj, simTimeVec, capture_info, Ux, Uy, mdata] = simulateswitching(attacker_init, target_init, defenders_init)
% simulateswitching.m  –  Hybrid RH‐switching at raw 0.05s steps
% Matches standalone script exactly by outputting raw trajectories.
% Inputs:
%   attacker_init   (2×1) [x; y]
%   target_init     (2×1) [x; y]
%   defenders_init  (2×N) initial [x; y] for N defenders
% Outputs:
%   attackerTraj, targetTraj, defenderTraj – raw agent positions at each time-step
%   simTimeVec                            – time vector (0:0.05:T)
%   capture_info                          – struct with capture result
%   Ux, Uy                                – planar velocities at each step
%   mdata                                 – log of "intercept"/"rescue" modes

    %--- Simulation parameters ---
    T       = 20;
    delta   = 0.05;
    time    = 0:delta:T;
    interp_factor = 12;
    delta_interp = delta / interp_factor;
    defender = size(defenders_init,2);
    agents   = defender + 2;
    maxSteps = length(time);

    %--- State initialization ---
    destroyed_defenders = false(1, defender);
    mdata               = strings;
    evade_position      = [];

    xinit = [attacker_init; target_init; defenders_init(:)];
    numState = length(xinit);
    x = zeros(numState, numel(time));
    x(:,1) = xinit;

    %--- Plot setup ---
    figure; hold on; axis equal; grid on;
    xlabel('X Position'); ylabel('Y Position');
    title('Trajectories: RH Mode (\sigma_a > \sigma_{d_i})');
    [Xa_path, Xd_paths, Xt_path] = initializePlots_2D(xinit, defender);

    %--- Initial RH interval ---
    Xa  = xinit(1:2);
    Xt  = xinit(2*(defender+1)+1 : 2*(defender+2));
    par = problemData_RH(Xa, Xt);
    t0  = 0;
    te  = t0 + par.deltaRH;

    capture = true;
    capture_position = [];
    capture_type     = [];
    c = [];
    k = 1;

    %--- Main mode-switching loop ---
    while capture && te <= T
        % decide mode
        if par.psi <= 0
            mode = "intercept";
        else
            mode = "rescue";
        end
        mdata(end+1) = mode;

        if mode == "intercept"
            % intercept: integrate and step inside micro-loop
            for j = k : (k + numel(t0:delta:te) - 2)
                if j > numel(time)-1, break; end
                if j == 1, x(:,j) = xinit; end

                % integrate fresh each sub-step
                c1 = find(destroyed_defenders);
                pari = problemData_MD_intercept(destroyed_defenders);
                initi = initializeHessians(pari);
                [~, yi] = ode45(@(t,y) odefun(t,y,pari,destroyed_defenders), T:-delta:0, initi);
                yi = flip(yi)';
                if ~isequal(c, c1)
                    pari = problemData_MD_intercept(destroyed_defenders);
                    initi = initializeHessians(pari);
                    [~, yi] = ode45(@(t,y) odefun(t,y,pari,destroyed_defenders), T:-delta:0, initi);
                    yi = flip(yi)';
                end

                % propagate
                Acli = calculateMatrices(yi, j, pari, destroyed_defenders);
                if size(Acli,1) ~= 2*agents
                    rows = sort([2*c1+1, 2*(c1+1)]);
                    Acli = expand_matrix_with_zeros(Acli, rows, rows);
                end
                x(:,j+1) = expm(Acli * delta) * x(:,j);

                % plot & capture check
                [Xai,Xdi,Xti] = updatePositions_2D(x, j+1, defender, destroyed_defenders);
                updatePlots_2D(Xa_path, Xd_paths, Xt_path, Xai, Xdi, Xti, defender, destroyed_defenders);
                [capture, capture_position, capture_type, destroyed_defenders, evade_position] = ...
                    checkCaptureforinterception(Xai, Xdi, Xti, pari, destroyed_defenders, time, j, evade_position);
                drawnow; pause(0.06);
                if ~capture, break; end
                c = c1;
            end

        else
            % rescue: integrate and step inside micro-loop
            for j = k : (k + numel(t0:delta:te) - 2)
                if j > numel(time)-1, break; end
                if j == 1, x(:,j) = xinit; end

                % integrate fresh each sub-step
                c1 = find(destroyed_defenders);
                parr = problemData_MD_rescue(destroyed_defenders);
                initr = initializeHessians(parr);
                [~, yr] = ode45(@(t,y) odefun(t,y,parr,destroyed_defenders), T:-delta:0, initr);
                yr = flip(yr)';
                if ~isequal(c, c1)
                    parr = problemData_MD_rescue(destroyed_defenders);
                    initr = initializeHessians(parr);
                    [~, yr] = ode45(@(t,y) odefun(t,y,parr,destroyed_defenders), T:-delta:0, initr);
                    yr = flip(yr)';
                end

                % propagate
                Aclr = calculateMatrices(yr, j, parr, destroyed_defenders);
                if size(Aclr,1) ~= 2*agents
                    rows = sort([2*c1+1, 2*(c1+1)]);
                    Aclr = expand_matrix_with_zeros(Aclr, rows, rows);
                end
                x(:,j+1) = expm(Aclr * delta) * x(:,j);

                % plot & capture check
                [Xar,Xdr,Xtr] = updatePositions_2D(x, j+1, defender, destroyed_defenders);
                updatePlots_2D(Xa_path, Xd_paths, Xt_path, Xar, Xdr, Xtr, defender, destroyed_defenders);
                [capture, capture_position, capture_type, destroyed_defenders, evade_position] = ...
                    checkCaptureforrescue(Xar, Xdr, Xtr, parr, destroyed_defenders, time, j, evade_position);
                drawnow; pause(0.06);
                if ~capture, break; end
                c = c1;
            end
        end

        % advance RH interval
        k   = j + 1;
        c   = [];
        t0  = te;
        Xa  = x(1:2,k-1);
        Xt  = x(end-1:end,k-1);
        par = problemData_RH(Xa, Xt);
        te  = t0 + par.deltaRH;
    end

    %--- Display & package capture_info ---
    disp('==== Mode Switching Log: ===='); disp(mdata');
    displayOutcome_2D(capture, capture_type, capture_position, pari, evade_position);
    % capture_info.capture          = capture;
    % capture_info.capture_position = capture_position;
    % capture_info.capture_type     = capture_type;
    % capture_info.pari             = par;
    % capture_info.evade_position   = evade_position;

    %--- Outputs at raw 0.05s resolution ---
    % finalIndex    = min(k, numel(time));
    % simTimeVec    = time(1:finalIndex);
    % attackerTraj  = x(1:2,   1:finalIndex);
    % targetTraj    = x(3:4,   1:finalIndex);
    % if defender>0
    %     defenderTraj = x(5:end, 1:finalIndex);
    % else
    %     defenderTraj = [];
    % end
    
    finalIndex = min(k, maxSteps);
    time_raw = time(1:finalIndex);
    x_raw = x(:, 1:finalIndex);

    t_interp = time_raw(1):delta_interp:time_raw(end);
    x_interp = zeros(numState, length(t_interp));
    for i = 1:numState
        x_interp(i,:) = interp1(time_raw, x_raw(i,:), t_interp, 'pchip');
    end
    
    total_agents = agents;
    Ux = zeros(total_agents, length(t_interp)-1);
    Uy = zeros(total_agents, length(t_interp)-1);
    for j = 1:length(t_interp)-1
        dx = (x_interp(:,j+1) - x_interp(:,j)) / delta;
        for i = 1:total_agents
            Ux(i,j) = dx(2*i - 1);
            Uy(i,j) = dx(2*i);
        end
    end

    attackerTraj = x_interp(1:2,:);
    targetTraj   = x_interp(3:4,:);
    if defender > 0
        defenderTraj = x_interp(5:end,:);
    else
        defenderTraj = [];
    end

    simTimeVec = t_interp;
    capture_info.capture = capture;
    capture_info.capture_position = capture_position;
    capture_info.capture_type = capture_type;
    capture_info.pari= pari;
    capture_info.evade_position= evade_position;
end
